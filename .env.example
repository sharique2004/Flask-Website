# Both optional. Without them, /ask falls back to curated answers.
# GEMINI_API_KEY powers answers and embeddings; ATLAS_CONNECTION_STRING
# powers vector retrieval over the bio corpus (see rag.py / bio_corpus.py).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ATLAS_CONNECTION_STRING=

# Local development only.
FLASK_DEBUG=0
